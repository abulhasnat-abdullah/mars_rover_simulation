<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_firmware</name>
  <version>0.0.1</version>
  <description>Hardware interface and firmware control for the rover with ODrive controllers</description>
  <maintainer email="abdkalam22@gmail.com">abulhasnat-abdullah</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime Dependencies -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>odrive_hardware_interface</exec_depend>
  
  <!-- Package Dependencies -->
  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_controller</exec_depend>
  
  <!-- Python Dependencies (for diagnostics script) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>