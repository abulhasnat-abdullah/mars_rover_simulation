Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1
        - /PointCloud21
        - /PointCloud21/Topic1
        - /RobotModel1
        - /LaserScan1
        - /Map1
