<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_nav2_slam_bringup</name>
  <version>0.0.1</version>
  <description>Bringup Nav2 using rover_localization local EKF (odom->base) and slam_toolbox live SLAM (map->odom).</description>

  <maintainer email="abdkalam22@gmail.com">abulhasnat-abdullah</maintainer>
  <license>MIT</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>opennav_docking</exec_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <exec_depend>rover_localization</exec_depend>
  <exec_depend>rover_mapping</exec_depend>
  <exec_depend>rover_navigation</exec_depend>

  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
